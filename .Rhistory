install.packages(c(
"tidyverse",
"ggplot2",
"caret",
"e1071",
"pheatmap",
"pROC",
"corrplot",
"randomForest",
"knitr",
"rmarkdown"
))
R.version.string
q()
library(pheatmap)
# First set working directory
setwd("C:/Users/ADMIN/Documents/Bioinformatic-Project---2020-ASP-83")
# Load data
df <- read.csv("Data/heart.csv")
# Load libraries
library(tidyverse)
library(pheatmap)
# Select numeric columns and calculate correlation
numeric_df <- df %>%
select(age, trestbps, chol, thalach, oldpeak, ca) %>%
cor()
# Print correlation matrix first
print(numeric_df)
# Display heatmap
pheatmap(numeric_df,
main = "Figure 4: Correlation Heatmap of Clinical Features",
color = colorRampPalette(c("blue", "white", "red"))(50),
display_numbers = TRUE,
number_format = "%.2f",
fontsize = 12)
# Save heatmap to Output folder
png("Output/figure4_heatmap.png", width = 800, height = 600)
pheatmap(numeric_df,
main = "Figure 4: Correlation Heatmap of Clinical Features",
color = colorRampPalette(c("blue", "white", "red"))(50),
display_numbers = TRUE,
number_format = "%.2f",
fontsize = 12)
dev.off()
cat("Figure 4 saved!")
library(ggplot2)
library(tidyverse)
# Recreate Figure 3
plot3 <- df %>%
select(target, chol, thalach) %>%
pivot_longer(cols = c(chol, thalach),
names_to = "Variable",
values_to = "Value") %>%
mutate(Variable = recode(Variable,
"chol" = "Cholesterol (mg/dl)",
"thalach" = "Max Heart Rate (bpm)")) %>%
ggplot(aes(x = target, y = Value, fill = target)) +
geom_boxplot(color = "black") +
facet_wrap(~Variable, scales = "free_y") +
labs(
title = "Figure 3: Cholesterol and Max Heart Rate by Heart Disease Status",
x = "Diagnosis",
y = "Value",
fill = "Diagnosis"
) +
theme_minimal() +
theme(legend.position = "none")
# Save it
ggsave("Output/figure3_boxplots.png", plot3, width = 8, height = 5)
cat("Figure 3 saved!")
