install.packages(c(
"tidyverse",
"ggplot2",
"caret",
"e1071",
"pheatmap",
"pROC",
"corrplot",
"randomForest",
"knitr",
"rmarkdown"
))
R.version.string
q()
setwd("C:/Users/ADMIN/Documents/Bioinformatic-Project---2020-ASP-83")
# Load data
df <- read.csv("Data/heart.csv")
# Convert factors
df$sex <- factor(df$sex, levels = c(0,1), labels = c("Female", "Male"))
df$cp <- factor(df$cp, levels = c(0,1,2,3), labels = c("Typical Angina", "Atypical Angina", "Non-anginal", "Asymptomatic"))
df$fbs <- factor(df$fbs, levels = c(0,1), labels = c("No", "Yes"))
df$restecg <- factor(df$restecg, levels = c(0,1,2), labels = c("Normal", "Abnormal", "Hypertrophy"))
df$exang <- factor(df$exang, levels = c(0,1), labels = c("No", "Yes"))
df$target <- factor(df$target, levels = c(0,1), labels = c("No Disease", "Heart Disease"))
cat("Data loaded!")
library(ggplot2)
library(tidyverse)
library(ggplot2)
# Reshape data manually without tidyverse
chol_data <- data.frame(
target = df$target,
Value = df$chol,
Variable = "Cholesterol (mg/dl)"
)
thalach_data <- data.frame(
target = df$target,
Value = df$thalach,
Variable = "Max Heart Rate (bpm)"
)
plot3_data <- rbind(chol_data, thalach_data)
# Figure 3 - Boxplots with colors
plot3 <- ggplot(plot3_data, aes(x = target, y = Value, fill = target)) +
geom_boxplot(color = "black") +
scale_fill_manual(values = c("No Disease" = "#FF9999",
"Heart Disease" = "#66B2FF")) +
facet_wrap(~Variable, scales = "free_y") +
labs(
title = "Figure 3: Cholesterol and Max Heart Rate by Heart Disease Status",
x = "Diagnosis",
y = "Value",
fill = "Diagnosis"
) +
theme_minimal() +
theme(legend.position = "none")
# Show plot
print(plot3)
# Save plot
ggsave("Output/figure3_boxplots.png", plot3, width = 8, height = 5, dpi = 300)
cat("Figure 3 saved!")
library(pheatmap)
# Select numeric columns and calculate correlation
numeric_df <- cor(df[, c("age", "trestbps", "chol", "thalach", "oldpeak", "ca")])
# Save heatmap
png("Output/figure4_heatmap.png", width = 800, height = 600)
pheatmap(numeric_df,
main = "Figure 4: Correlation Heatmap of Clinical Features",
color = colorRampPalette(c("blue", "white", "red"))(50),
display_numbers = TRUE,
number_format = "%.2f",
fontsize = 12)
dev.off()
# Display heatmap
pheatmap(numeric_df,
main = "Figure 4: Correlation Heatmap of Clinical Features",
color = colorRampPalette(c("blue", "white", "red"))(50),
display_numbers = TRUE,
number_format = "%.2f",
fontsize = 12)
cat("Figure 4 saved!")
# Check if file exists
file.exists("Output/figure4_heatmap.png")
# Force display in RStudio plots panel
dev.new()
pheatmap(numeric_df,
main = "Figure 4: Correlation Heatmap of Clinical Features",
color = colorRampPalette(c("blue", "white", "red"))(50),
display_numbers = TRUE,
number_format = "%.2f",
fontsize = 12)
# List all files in Output folder
list.files("Output/")
# Recreate correlation matrix
numeric_df <- cor(df[, c("age", "trestbps", "chol", "thalach", "oldpeak", "ca")])
# Delete old file first
file.remove("Output/figure4_heatmap.png")
# Save new file
png("Output/figure4_heatmap.png", width = 1200, height = 900, res = 150)
pheatmap(numeric_df,
main = "Figure 4: Correlation Heatmap of Clinical Features",
color = colorRampPalette(c("blue", "white", "red"))(50),
display_numbers = TRUE,
number_format = "%.2f",
fontsize = 14)
dev.off()
cat("Figure 4 saved! Size:", file.size("Output/figure4_heatmap.png"), "bytes")
